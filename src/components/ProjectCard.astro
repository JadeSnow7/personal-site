---
interface Props {
  title: string;
  description: string;
  status: string;
  stack: string[];
  github?: string;
  demo?: string;
  index?: number;
  headingLevel?: 2 | 3;
}

const { title, description, status, stack, github, demo, index = 0, headingLevel = 2 } = Astro.props;
const statusLabel = status.replace('-', ' ');
---
<article class="project-card flex min-h-[20rem] flex-col">
  <div class="flex items-start justify-between gap-4"><span class="eyebrow">{String(index + 1).padStart(2, '0')} / {statusLabel}</span><span class="text-2xl text-[var(--signal)]" aria-hidden="true">↗</span></div>
  {headingLevel === 3 ? <h3 class="mt-12 text-2xl font-semibold">{title}</h3> : <h2 class="mt-12 text-2xl font-semibold">{title}</h2>}
  <p class="mt-3 text-sm leading-6 text-[var(--muted)]">{description}</p>
  <ul class="mt-6 flex flex-wrap gap-2" aria-label={`${title} technologies`}>{stack.map((item) => <li class="tag">{item}</li>)}</ul>
  <div class="mt-auto flex flex-wrap gap-4 pt-8 text-sm font-bold">
    {github && <a href={github} target="_blank" rel="noreferrer" class="underline decoration-[var(--signal)] decoration-2 underline-offset-4">GitHub <span aria-hidden="true">↗</span></a>}
    {demo && <a href={demo} target="_blank" rel="noreferrer" class="underline decoration-[var(--signal)] decoration-2 underline-offset-4">Demo <span aria-hidden="true">↗</span></a>}
    {!github && !demo && <span class="text-xs font-normal text-[var(--muted)]">No public link yet · in progress</span>}
  </div>
</article>
