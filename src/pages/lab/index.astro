---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
const experiments = (await getCollection('lab')).filter(({ data }) => !data.draft).sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---
<BaseLayout title="Lab · AI Engineering Hub" description="实验记录：AI Agent、评估、接口和系统设计的可检查小实验。" keywords={['AI Lab', 'Agent Evaluation', 'AI Agent', 'Engineering Notes']}>
  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8"><p class="eyebrow">Lab / controlled experiments</p><h1 class="display-face mt-4 max-w-4xl text-5xl tracking-[-0.04em] sm:text-7xl">Small loops, honest status.</h1><p class="mt-7 max-w-2xl text-lg leading-8 text-[var(--muted)]">A record of hypotheses, probes, and unfinished work. An experiment marked in progress is not a product claim.</p><div class="mt-12 grid gap-5 md:grid-cols-2">{experiments.map((experiment, index) => <article class="runtime-panel"><div class="flex items-center justify-between"><span class="eyebrow">{String(index + 1).padStart(2, '0')} / {experiment.data.status}</span><time class="text-xs text-[var(--muted)]" datetime={experiment.data.publishedAt.toISOString()}>{experiment.data.publishedAt.toLocaleDateString('en-GB')}</time></div><h2 class="mt-8 text-2xl font-semibold">{experiment.data.title}</h2><p class="mt-3 text-[var(--muted)]">{experiment.data.description}</p>{experiment.data.hypothesis && <p class="mt-6 border-l-2 border-[var(--signal)] pl-4 text-sm leading-6"><strong>Hypothesis</strong><br />{experiment.data.hypothesis}</p>}</article>)}</div></section>
</BaseLayout>
