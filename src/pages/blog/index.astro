---
import { getCollection } from 'astro:content';
import TagFilter from '../../components/TagFilter';
import BaseLayout from '../../layouts/BaseLayout.astro';

const entries = (await getCollection('blog'))
  .filter(({ data }) => !data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const articles = entries.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  description: entry.data.description,
  date: entry.data.date.toISOString(),
  tags: entry.data.tags,
}));
---
<BaseLayout title="Blog · AI Engineering Hub" description="AI Agent、Rust、系统设计与工程实践的 field notes。">
  <section class="mx-auto max-w-6xl px-5 py-20 lg:px-8">
    <p class="eyebrow">Blog / dispatches</p>
    <h1 class="display-face mt-4 text-5xl tracking-[-0.04em]">Longer field reports.</h1>
    <p class="mt-6 max-w-2xl text-lg leading-8 text-[var(--muted)]">Notes and examples about agent systems, Rust, system design, and the engineering work around them.</p>
    <div class="mt-12 js-filter-shell"><TagFilter articles={articles} client:idle /></div>
    <noscript><div class="mt-12 divide-y divide-[var(--line)] border-y border-[var(--line)]">{entries.map((entry) => <a class="article-row" href={`/blog/${entry.id}/`}><time datetime={entry.data.date.toISOString()}>{entry.data.date.toLocaleDateString('en-GB')}</time><div><h2 class="text-2xl font-semibold">{entry.data.title}</h2><p>{entry.data.description}</p><p class="mt-2 text-xs uppercase tracking-widest text-[var(--signal)]">{entry.data.tags.join(' · ')}</p></div><span aria-hidden="true">↗</span></a>)}</div></noscript>
  </section>
</BaseLayout>
