---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="404 · AI Engineering Hub" description="This route does not exist in the AI Engineering Hub.">
  <section class="mx-auto max-w-3xl px-5 py-28 lg:px-8"><p class="eyebrow">404 / route not found</p><h1 class="display-face mt-4 text-6xl tracking-[-0.04em]">Signal lost.</h1><p class="mt-6 text-lg leading-8 text-[var(--muted)]">The requested path is not part of this build.</p><a class="button button-signal mt-8" href="/">Return to the hub <span aria-hidden="true">↗</span></a></section>
</BaseLayout>
