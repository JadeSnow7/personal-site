---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { absoluteUrl } from '../utils/seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  keywords?: string[];
  ogType?: 'website' | 'article';
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title = 'AI Engineering Hub',
  description = 'Notes on building reliable AI systems.',
  keywords = ['AI Agent', 'Harness Engineering', 'Rust', 'LLM Application', 'Forge Studio'],
  ogType = 'website',
  jsonLd,
} = Astro.props;
const canonical = absoluteUrl(Astro.url.pathname);
const ogImage = absoluteUrl('/og-card.png');
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords.join(', ')} />
    <meta name="author" content="胡傲东" />
    <meta name="robots" content="index, follow" />
    <link rel="canonical" href={canonical} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="胡傲东 · AI Engineering Hub" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="胡傲东 · AI Engineer · Agent Runtime and AI Native Tools" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content="胡傲东 · AI Engineer · Agent Runtime and AI Native Tools" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    {jsonLd && <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-10 focus:bg-[var(--ink)] focus:px-3 focus:py-2 focus:text-[var(--paper)]" href="#main">Skip to content</a>
    <Header />
    <main id="main"><slot /></main>
    <Footer />
  </body>
</html>
